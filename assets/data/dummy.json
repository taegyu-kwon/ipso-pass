  "notices": [
    { "id": "n1", "reservistId": "r1", "dateLabel": "10.20 (화)", "title": "훈련 일정을 안내해요", "body": "11월 16일부터 19일까지 금곡과학화예비군훈련장(1훈련장)에서 출퇴근 훈련을 진행해요. 매일 08:50까지 입소해요. 훈련 카드에는 첫날 날짜가 표시돼요.", "read": true },
    { "id": "n2", "reservistId": "r1", "dateLabel": "11.09 (월)", "title": "입소패스 준비가 열렸어요", "body": "개인정보와 지급 계좌를 확인하고 건강 문진에 답변해요. 필수 동의를 마치면 입소패스를 준비할 수 있어요.", "read": false },
    { "id": "n3", "reservistId": "r1", "dateLabel": "10.21 (수)", "title": "지난 훈련 이력을 확인해요", "body": "지난해 동원미참훈련 이수 내역이 등록돼 있어요. 훈련 이력에서 확인해요.", "read": true },
    { "id": "n4", "reservistId": "r2", "dateLabel": "10.20 (화)", "title": "첫 동원훈련 일정을 안내해요", "body": "11월 10일부터 12일까지 별내 동원훈련장(55동원지원단)에서 숙영 훈련을 진행해요. 첫날 08:50까지 입소하고 마지막 날 17:00에 퇴소해요.", "read": true },
    { "id": "n5", "reservistId": "r2", "dateLabel": "11.03 (화)", "title": "입소패스 준비가 열렸어요", "body": "건강 문진과 필수 동의를 완료해요. 숙영에 필요한 개인용품도 함께 준비해요.", "read": false },
    { "id": "n6", "reservistId": "r3", "dateLabel": "10.20 (화)", "title": "기본훈련 일정을 안내해요", "body": "11월 12일 단원 과학화예비군훈련장에서 기본훈련을 진행해요. 08:50까지 입소하고 18:00에 종료해요.", "read": true },
    { "id": "n7", "reservistId": "r3", "dateLabel": "11.05 (목)", "title": "입소패스 준비가 열렸어요", "body": "본인 정보와 지급 계좌를 확인해요. 건강 문진과 필수 동의를 마치면 준비가 완료돼요.", "read": false },
    { "id": "n8", "reservistId": "r3", "dateLabel": "10.21 (수)", "title": "훈련 로드맵을 확인해요", "body": "5~6년차 횟수는 기본훈련 1회와 작계훈련 2회를 합산해요. 현재 카드에는 기본훈련 1건만 표시해요. 7~8년차 점검은 이수 내역 확인을 뜻해요.", "read": true },
    { "id": "n9", "reservistId": "r4", "dateLabel": "11.16 (월)", "title": "훈련 일정이 변경됐어요", "body": "훈련 시작일이 11월 23일에서 12월 7일로 변경됐어요. 장소는 부산과학화예비군훈련장(2훈련장)으로 같아요.", "read": false },
    { "id": "n10", "reservistId": "r4", "dateLabel": "11.17 (화)", "title": "변경된 출석일을 확인해요", "body": "12월 7일부터 10일까지 출퇴근 훈련을 진행해요. 매일 08:50까지 입소해요. 이전 날짜 대신 변경된 날짜를 확인해요.", "read": false },
